## --- Required ---
POSTGRES_PASSWORD="replace_with_a_strong_db_password"
BETTER_AUTH_SECRET="replace_with_a_strong_random_secret"
SEARXNG_SECRET="replace_with_a_strong_random_secret"
## Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

## DB URL is interpolated from POSTGRES_* by dotenvx (override any with a plain KEY=).
DATABASE_URL="postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@${POSTGRES_HOST:-localhost}:${POSTGRES_PORT:-5432}"
## Database for the DB-backed `server` test project; `npm run test` resets it on every run.
TEST_DATABASE_URL="postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@${POSTGRES_HOST:-localhost}:${POSTGRES_PORT:-5432}/test"

## --- Optional Overrides ---
#BETTER_AUTH_URL="http://localhost:3000"  # defaults to the app's own origin
#SEARXNG_URL="http://localhost:8080"  # web search; compose wires searxng:8080
#HF_TOKEN=""  # optional; lifts Hugging Face limits for the Library catalog and llama.cpp downloads
#LOG_LEVEL=info  # server log level: debug, info, warn or error
#LLAMA_ARG_SLEEP_IDLE_SECONDS=300  # bundled llama.cpp frees an idle model's RAM/VRAM after this long
#LLAMA_ARG_N_GPU_LAYERS=auto  # GPU layers for bundled llama.cpp; auto fits them to free VRAM, 0 forces CPU-only
#LLAMA_ARG_CTX_SIZE=0  # context length; 0 takes the model's, then auto-fit shrinks it to fit
#LLAMA_ARG_LOAD_MODE=mmap  # Vulkan overlay default; set auto to use llama.cpp's own default
#LLAMA_ARG_MMPROJ_OFFLOAD=0  # keep a vision model's projector off the GPU when VRAM is tight
#LLAMA_API_KEY=""  # bundled llama.cpp's --api-key; defaults to a fixed placeholder, set your own to lock it down

## --- Docker Compose ---
## Profiles: prod (built image) or dev (Vite HMR), plus llamacpp for the bundled llama-server.
COMPOSE_PROFILES=prod,llamacpp
## GPU overlay: nvidia (CUDA), amd (ROCm) or vulkan (Intel/AMD).
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
