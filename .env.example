# --- Required ---
POSTGRES_PASSWORD="replace-with-a-strong-db-password"
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"

# 64-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""
BETTER_AUTH_URL="http://localhost:3000"

# Native `npm run dev` connects directly to localhost; compose builds its own URL
# from POSTGRES_* (use the same password you set above).
DATABASE_URL="postgresql://postgres:replace-with-a-strong-db-password@localhost:5432/localghost"

# --- Optional (compose.yaml supplies these defaults if unset) ---
# POSTGRES_USER=postgres   POSTGRES_DB=localghost
# SEARXNG_URL=http://searxng:8080   # bundled keyless web search; set your own for native dev

# --- Docker Compose run selection (only read when running via compose) ---
# COMPOSE_PROFILES (comma-joined): run mode + optional bundled Ollama.
#   dev      Vite with HMR over a bind mount    prod   the built image
#   ollama   bundled Ollama container (omit to use a host-native Ollama)
COMPOSE_PROFILES=ollama,dev

# COMPOSE_FILE: GPU hardware overlay (Ollama + Library hardware panel).
#   compose.yaml:compose.nvidia.yaml   NVIDIA (NVIDIA Container Toolkit)
#   compose.yaml:compose.amd.yaml      AMD (ROCm)
#   compose.yaml:compose.vulkan.yaml   Vulkan (Intel, or AMD without ROCm)
# COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
