# --- Postgres (compose `db` + DATABASE_URL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp

# Native dev points at localhost; compose overrides the host to db:5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myapp"

# --- Auth ---
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# 64-char hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# --- Optional ---
SEARXNG_URL="http://localhost:8080"   # web search; falls back to DuckDuckGo if unset
# ADMIN_EMAIL="you@example.com"        # restrict /admin; default = first registered user

# --- Docker Compose run selection ---
# COMPOSE_PROFILES (comma-joined): run mode + optional bundled Ollama.
#   prod     built image          dev      Vite with HMR
#   ollama   bundled Ollama container (omit to use a host-native Ollama)
COMPOSE_PROFILES=ollama,prod

# COMPOSE_FILE: GPU hardware overlay (Ollama + cookbook hardware panel).
# Leave unset for CPU. Needs the matching host GPU runtime.
#   compose.yaml:compose.nvidia.yaml   NVIDIA (NVIDIA Container Toolkit)
#   compose.yaml:compose.amd.yaml      AMD (ROCm)
#   compose.yaml:compose.vulkan.yaml   Vulkan (Intel, or AMD without ROCm)
# COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
