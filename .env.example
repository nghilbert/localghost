## --- Required ---
POSTGRES_PASSWORD="replace_with_a_strong_db_password"
BETTER_AUTH_SECRET="replace_with_a_strong_random_secret"
SEARXNG_SECRET="replace_with_a_strong_random_secret"
## Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

## DB URL is interpolated from POSTGRES_* by dotenvx (override any with a plain KEY=).
DATABASE_URL="postgresql://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@${POSTGRES_HOST:-localhost}:${POSTGRES_PORT:-5432}/${POSTGRES_DB:-localghost}"

## --- Optional overrides (single # + KEY = uncomment to enable) ---
#BETTER_AUTH_URL="http://localhost:3000"  # defaults to the app's own origin
#SEARXNG_URL="http://localhost:8080"  # web search; compose wires searxng:8080
#HF_TOKEN=""  # optional; lifts Hugging Face limits for the Library catalog and llama.cpp downloads
#LLAMA_SLEEP_IDLE_SECONDS=300  # bundled llama.cpp frees an idle model's RAM/VRAM after this long
#LLAMACPP_API_KEY=""  # bundled llama.cpp's --api-key; defaults to a fixed placeholder, set your own to lock it down
#CODE_AGENT_WORKSPACE_ROOT="/home/you/projects"  # tree /agent's folder browser opens into, mounted at this same path in the container; defaults to your home directory

## --- Docker Compose (only read when running via compose) ---
## COMPOSE_PROFILES: dev (Vite HMR) | prod (built image), plus optional llamacpp.
COMPOSE_PROFILES=dev,llamacpp
## COMPOSE_FILE: GPU overlay — nvidia (CUDA) | amd (ROCm) | vulkan (Intel/AMD). Stacks.
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
