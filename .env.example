# PostgreSQL credentials (used by compose.yaml and DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp

# For native dev; the compose run overrides the host to db:5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myapp"
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
ENCRYPTION_KEY="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
SEARXNG_URL="http://localhost:8080"

# Optional: restrict /admin to a specific user email.
# If not set, the first registered user gets admin access.
# ADMIN_EMAIL="you@example.com"

# GPU hosts add a hardware overlay so the cookbook hardware panel can read the
# GPU from inside the web container (needs the NVIDIA Container Toolkit):
#   COMPOSE_FILE=compose.yaml:compose.nvidia.yaml   # or compose.amd.yaml
# CPU-only hosts leave COMPOSE_FILE unset (defaults to compose.yaml).
COMPOSE_PROFILES=cpu,dev
COMPOSE_FILE=compose.yaml
