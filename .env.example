# PostgreSQL credentials (used by compose.yaml and DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=myapp

# For native dev; the compose run overrides the host to db:5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myapp"
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
ENCRYPTION_KEY="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
SEARXNG_URL="http://localhost:8080"

# Optional: restrict /admin to a specific user email.
# If not set, the first registered user gets admin access.
# ADMIN_EMAIL="you@example.com"

# Compose profiles select an Ollama hardware variant (cpu, nvidia, or amd;
# nvidia needs the NVIDIA container toolkit) plus a run mode: prod (the built
# image) or dev (Vite with HMR over a bind mount). Use `cpu,dev` for dockerized
# dev. Drop the Ollama variant to use your own host Ollama instead.
COMPOSE_PROFILES=cpu,prod
