	"scripts": {
		"predev": "prisma migrate deploy",
		"dev": "dotenvx run --quiet --ignore=MISSING_ENV_FILE -- vite dev --port 3000",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && vite build",
		"format": "biome format",
		"check": "biome check",
		"lint": "biome lint",
		"fix": "biome check --write",
		"test": "dotenvx run --quiet --ignore=MISSING_ENV_FILE -- vitest",
		"prisma": "prisma"
	},
	"prisma": {
		"seed": "dotenvx run --quiet -- tsx prisma/seed.ts"
	},
