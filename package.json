{
	"name": "localghost",
	"private": true,
	"type": "module",
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": "26"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"predev": "prisma migrate deploy",
		"dev": "dotenvx run --quiet --ignore=MISSING_ENV_FILE -- vite dev --port 3000",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && vite build",
		"test": "dotenvx run --quiet --ignore=MISSING_ENV_FILE -- vitest",
		"biome": "biome",
		"biome:fix": "biome check --write",
		"prisma": "prisma"
	},
