{
	"name": "localghost",
	"private": true,
	"type": "module",
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": "26"
	},
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"predev": "prisma migrate deploy",
		"dev": "dotenvx run --quiet --ignore=MISSING_ENV_FILE -- vite dev --port 3000",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && vite build",
		"test": "dotenvx run --quiet --ignore=MISSING_ENV_FILE -- vitest",
		"lint": "eslint --flag unstable_native_nodejs_ts_config",
		"format": "prettier --write .",
		"prisma": "prisma"
	},
	"overrides": {
		"@tanstack/ai-persistence": {
			"vitest": "$vitest"
		},
		"@tanstack/ai-memory": {
			"vitest": "$vitest"
		}
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@dotenvx/dotenvx": "^2.38.2",
		"@fontsource-variable/geist": "^5.3.0",
		"@huggingface/gguf": "^0.4.6",
		"@huggingface/hub": "^2.17.9",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/ai": "^0.71.0",
		"@tanstack/ai-anthropic": "^0.23.0",
		"@tanstack/ai-client": "^0.40.1",
		"@tanstack/ai-gemini": "^0.38.2",
		"@tanstack/ai-memory": "^0.2.16",
		"@tanstack/ai-openai": "^0.31.0",
		"@tanstack/ai-persistence": "^0.10.1",
		"@tanstack/ai-react": "^0.31.1",
		"@tanstack/highlight": "^1.1.0",
		"@tanstack/markdown": "^1.0.0",
		"@tanstack/match-sorter-utils": "^9.2.6",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "^1.170.44",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.4",
		"better-auth": "^1.7.12",
		"defuddle": "^0.19.6",
		"linkedom": "^0.18.14",
		"lucide-react": "^1.61.0",
		"nitro": "^3.0.260903-beta",
		"pino": "^10.4.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"undici": "^8.12.3",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@babel/core": "^8.0.9",
		"@eslint-react/eslint-plugin": "^5.28.8",
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.6.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/eslint-plugin-query": "^5.104.5",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@tanstack/react-ai-devtools": "^0.2.71",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-form-devtools": "^0.2.34",
		"@tanstack/react-query-devtools": "^5.104.5",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@~7.0.2",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/browser-playwright": "^5.0.3",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/eslint-plugin": "^1.6.28",
		"@vitest/ui": "^5.0.3",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-unicorn": "^79.0.0",
		"msw": "^3.0.3",
		"pino-pretty": "^13.2.0",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"prisma": "^7.10.1",
		"prisma-json-types-generator": "^5.2.0",
		"tsx": "^4.23.15",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-react": "^2.3.0"
	},
	"allowScripts": {
		"@google/genai": true,
		"@prisma/engines": true,
		"esbuild": true,
		"msw": true,
		"prisma": true,
		"protobufjs": true
	}
}
