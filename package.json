		"check": "biome check",
		"lint": "biome lint",
		"fix": "biome check --write",
		"test": "vitest",
		"prisma": "prisma"
	},
	"prisma": {
		"seed": "dotenvx run --quiet -- tsx prisma/seed.ts"
	},
