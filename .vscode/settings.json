{
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },
	"[dockercompose]": { "editor.defaultFormatter": "ms-azuretools.vscode-containers" },
	"editor.codeActionsOnSave": { "source.fixAll.eslint": "explicit" },
	"eslint.options": { "flags": ["unstable_native_nodejs_ts_config"] },
	"js/ts.tsdk.path": "node_modules/@typescript/native/lib",
	"js/ts.tsdk.promptToUseWorkspaceVersion": true,
	"js/ts.preferences.importModuleSpecifierEnding": "minimal",
	"js/ts.tsserver.experimental.enableProjectDiagnostics": true,
	"files.associations": { "*.css": "tailwindcss" }
}
