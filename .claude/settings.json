{
	"enableAllProjectMcpServers": true,
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-generated.ts"
					}
				]
			},
			{
				"matcher": "Read|Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-env.ts"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-prisma.ts"
					},
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.ts"
					}
				]
			}
		],

		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/biome-fix.ts"
					},
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/prose-check.ts"
					},
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-stop.ts --mark"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-stop.ts",
						"timeout": 150
					}
				]
			}
		]
	}
}
