{
	"enableAllProjectMcpServers": true,
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Read|Edit|Write|NotebookEdit|Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/guards.ts"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/biome-fix.ts"
					},
					{
						"type": "command",
						"command": "node ${CLAUDE_PROJECT_DIR}/.claude/hooks/text-check.ts"
					}
				]
			}
		]
	}
}
