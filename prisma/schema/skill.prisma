/// A user-defined persona or instruction set the agent can assume.
model Skill {
    id          String   @id @default(uuid(7))
    name        String
    description String
    content     String
    ownerId     String
    owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([ownerId])
    @@map("skill")
}
