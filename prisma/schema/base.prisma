generator client {
  provider        = "prisma-client"
  output          = "../../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

/// Types `Json` fields from `/// [Type]` comments, resolved in the global `PrismaJson` namespace.
generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}
