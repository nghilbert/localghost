/// A conversation's transcript for `withPersistence`, keyed by `threadId`, which is the
/// `Conversation.id` as a string. The store must be able to create a thread on its own,
/// so there is no owner and no foreign key.
model ChatThread {
  threadId  String   @id @map("thread_id")
  messages  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chat_thread")
}

/// A chat run for `withPersistence`. The library creates `runId`, which is not a UUID.
/// `status` is a string, so an unknown value fails in app code instead of in the database.
/// There are no foreign keys: the library's conformance tests write runs for threads
/// that do not exist, as its Prisma recipe allows.
model ChatRun {
  runId           String   @id @map("run_id")
  threadId        String   @map("thread_id")
  status          String
  startedAt       BigInt   @map("started_at")
  finishedAt      BigInt?  @map("finished_at")
  error           String?
  errorCode       String?  @map("error_code")
  usage           Json?
  sandboxKey      String?  @map("sandbox_key")
  detachedSince   BigInt?  @map("detached_since")
  cancelRequested Boolean? @map("cancel_requested")
  driverEpoch     Int?     @map("driver_epoch")

  @@index([threadId, status])
  @@index([threadId, startedAt])
  // For `listReclaimable`.
  @@index([status, detachedSince])
  @@map("chat_run")
}

/// A pending or answered tool approval for `withPersistence`.
model ChatInterrupt {
  interruptId String  @id @map("interrupt_id")
  runId       String  @map("run_id")
  threadId    String  @map("thread_id")
  status      String
  requestedAt BigInt  @map("requested_at")
  resolvedAt  BigInt? @map("resolved_at")
  payload     Json
  response    Json?

  @@index([threadId, requestedAt])
  @@index([runId, requestedAt])
  @@map("chat_interrupt")
}
