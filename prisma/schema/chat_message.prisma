model ChatMessage {
    id        String      @id @default(uuid(7))
    sessionId String
    session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    role      String
    content   String
    metadata  Json?
    createdAt DateTime    @default(now())

    @@index([sessionId])
    @@index([sessionId, createdAt])
    @@map("chat_message")
}
