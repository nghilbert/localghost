/// A saved system-prompt + model configuration that can be applied to any chat session.
model ChatPreset {
    id           String   @id @default(uuid(7))
    name         String
    description  String?
    systemPrompt String
    model        String?
    temperature  Float?
    mode         String?
    ownerId      String
    owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([ownerId])
    @@map("chat_preset")
}
