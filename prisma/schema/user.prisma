model User {
    id             String          @id
    name           String
    email          String
    emailVerified  Boolean         @default(false)
    image          String?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    sessions       Session[]
    accounts       Account[]
    modelEndpoints ModelEndpoint[]
    chatSessions   ChatSession[]
    memories       Memory[]
    skills         Skill[]
    documents      Document[]
    emailAccounts  EmailAccount[]
    emailSummaries EmailSummary[]
    calendars      CalendarCal[]
    calendarEvents CalendarEvent[]
    scheduledTasks ScheduledTask[]
    notes          Note[]
    contacts       Contact[]
    webhooks       Webhook[]
    apiTokens      ApiToken[]
    chatPresets    ChatPreset[]

    @@unique([email])
    @@map("user")
}
