model Contact {
  id        String   @id @default(uuid(7))
  name      String
  emails    Json     @default("[]")
  phones    Json     @default("[]")
  notes     String?
  uid       String?
  source    String   @default("local")
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
