model Contact {
  id        String   @id @default(uuid(7))
  name      String
  emails    Json     @default("[]")
  phones    Json     @default("[]")
  notes     String?
  uid       String?
  source    String   @default("local")
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@map("contact")
}
