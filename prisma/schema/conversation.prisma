/// A chat's owner, model, and title. Its transcript is the `ChatThread` whose `threadId` is this `id`.
model Conversation {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String    @default("New Chat")
  endpointId String?   @map("endpoint_id") @db.Uuid
  endpoint   Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  model      String?
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("conversation")
}
