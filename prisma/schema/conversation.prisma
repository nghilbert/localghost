/// A chat conversation: the business record (owner, model, title). The
/// transcript itself lives in `ChatThread`, keyed by this row's `id` as
/// `threadId` — see that model's comment for why it's a separate table.
model Conversation {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String    @default("New Chat")
  endpointId String?   @map("endpoint_id") @db.Uuid
  endpoint   Endpoint? @relation(fields: [endpointId], references: [id], onDelete: SetNull)
  model      String?
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("conversation")
}
