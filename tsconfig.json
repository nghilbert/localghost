{
	"include": ["**/*.ts", "**/*.tsx"],
	"compilerOptions": {
		/* Language target and environment */
		"target": "ES2025",
		"lib": ["ES2025", "DOM"],
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"paths": { "#/*": ["./src/*"] },

		/* Bundler mode: Vite transpiles, TypeScript only type-checks */
		"module": "preserve",
		"noEmit": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"erasableSyntaxOnly": true,
		"skipLibCheck": true,

		/* Strictness */
		"noImplicitOverride": true,
		"noUncheckedIndexedAccess": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true
	}
}
